{
  "expo": {
    "name": "HiGO Driver",
    "slug": "higo-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-icon.png",
    "scheme": "higodriver",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.driverapp",
      "config": {
        "googleMapsApiKey": "AIzaSyAdGR4OqjWjO6NG4cbpNKffbRhEqlhH4Tw"
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-audio",
      "@sentry/react-native",
      [
        "expo-image-picker",
        {
          "cameraPermission": "HiGO Driver uses the camera to capture your KYC documents.",
          "photosPermission": "HiGO Driver needs access to your photos to upload KYC documents."
        }
      ]
    ],
    "android": {
      "package": "com.driverapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAfmoovUBAAMK2hLAFYf0ZUcZaPZupJ2dA"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "versionCode": 2
    },
    "extra": {
      "eas": {
        "projectId": "4cd8fd34-fa56-4cf2-aaec-4163f5329143"
      }
    }
  }
}
