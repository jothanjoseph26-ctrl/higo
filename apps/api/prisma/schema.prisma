  @@index([isActive])
  @@index([priority])
  @@map("mobility_corridors")
}

model InspectionCenter {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  address               String
  lat                   Decimal? @db.Decimal(10, 7)
  lng                   Decimal? @db.Decimal(10, 7)
  phone                 String?
  email                 String?
  managerName           String?  @map("manager_name")
  operatingHours        Json?    @map("operating_hours") @db.JsonB
  capacityPerDay        Int      @default(50) @map("capacity_per_day")
  vehicleTypesSupported Json     @default("[]") @map("vehicle_types_supported") @db.JsonB
  isActive              Boolean  @default(true) @map("is_active")
  city                  String   @default("Abuja")
  description           String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([city])
  @@index([isActive])
  @@map("inspection_centers")
}

model FareProfile {
