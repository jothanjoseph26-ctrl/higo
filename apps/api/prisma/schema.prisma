model Referral {
  id                  String                @id @default(uuid()) @db.Uuid
  referrerId          String                @map("referrer_id") @db.Uuid
  referrerName        String?               @map("referrer_name")
  referrerType        ReferralSourceType    @default(driver) @map("referrer_type")
  code                String
  referredEmail       String?               @map("referred_email")
  referredUserId      String?               @map("referred_user_id") @db.Uuid
  referredDriverId    String?               @map("referred_driver_id") @db.Uuid
  referrerReward      Int                   @default(50000) @map("referrer_reward")
  referredReward      Int                   @default(50000) @map("referred_reward")
  commissionPct       Decimal?              @map("commission_pct") @db.Decimal(5, 2)
  subscriptionAmount  Int?                  @map("subscription_amount")
  subscriptionPlan    SubscriptionTier?     @map("subscription_plan")
  commissionAmount    Int?                  @map("commission_amount")
  status              Base44ReferralStatus  @default(pending)
  triggeredAt         DateTime?             @map("triggered_at")
  cashoutStatus       ReferralCashoutStatus @default(pending) @map("cashout_status")
  cashoutRequestedAt  DateTime?             @map("cashout_requested_at")
  cashoutPaidAt       DateTime?             @map("cashout_paid_at")
  completedAt         DateTime?             @map("completed_at")
  description         String?
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  referredUser        User?                 @relation("ReferredUser", fields: [referredUserId], references: [id])
  referredDriver      Driver?               @relation("ReferralReferredDriver", fields: [referredDriverId], references: [id])

  @@index([referrerId])
  @@index([referredUserId])
  @@index([referredDriverId])
  @@index([code])
  @@index([status])
  @@index([cashoutStatus])
  @@map("referrals")
}

