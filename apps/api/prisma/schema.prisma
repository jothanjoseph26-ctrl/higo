// ============================================================================
// HiGO Abuja — Prisma Schema (PostgreSQL 15 + PostGIS)
// Mobility module of the Hiconnect Super App
// MOU ref: JTL/HGS/HGO/001/2026
//
// NOTES:
// - PostGIS geography columns are declared with Unsupported(...) because Prisma
//   has no native geography type. All reads/writes to these columns MUST use
//   $queryRaw / $executeRaw with ST_* functions and SRID 4326.
// - Before first migration run, ensure: CREATE EXTENSION IF NOT EXISTS postgis;
//   (also enable the postgis extension via a manual migration step — see
//   monorepo-setup.md, step 6).
// - All monetary values are stored in KOBO as Int (never floats). Currency NGN.
// - Spatial (GiST) indexes on geography columns must be added via raw SQL in a
//   migration (Prisma cannot express USING GIST). See the migration note blocks.
// - JSONB columns use Prisma's Json type.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================================
// ENUMS
// ============================================================================

enum TripStatus {
  requested
  matched
  arrived
  en_route
  active
  completed
  cancelled
}

enum RideMode {
  instant
  negotiate
  share
  schedule_flex
  schedule_exact
}

enum FareNegotiationStatus {
  active
  accepted
  rejected
  expired
  cancelled
}

enum KYCStatus {
  pending
  under_review
  approved
  rejected
}

enum DriverApplicationStatus {
  new
  contacted
  invited
  converted
  rejected
}

enum ContactSubmissionStatus {
  new
  triaged
  closed
}

enum VehicleType {
  keke      // keke napep (motorised tricycle) — Phase 1 primary
  car       // reserved for future
  bike      // reserved for future
}

enum ZoneType {
  permitted // launch/service zones
  restricted // legally restricted (FCTA) — no pickup/dropoff allowed
  surge      // dynamic pricing zone
}

enum SubscriptionTier {
  daily
  weekly
  monthly
}

enum DisputeStatus {
  open
  investigating
  resolved
  dismissed
}

enum AdminRole {
  super_admin
  admin
  moderator
  supervisor
  inspection_centre
}

enum PaymentMethod {
  card
  bank
  ussd
  cash // settled offline; recorded for reporting
}

enum PaymentStatus {
  pending
  held      // escrow hold after charge.success
  released  // disbursed/settled after trip completion
  failed
  refunded
}

enum DeliveryStatus {
  requested
  accepted
  picked_up
  en_route
  delivered
  cancelled
}

enum ParcelSize {
  small
  medium
  large
}

enum LoyaltyTier {
  bronze
  silver
  gold
  platinum
}

enum ReferralSourceType {
  driver
  staff
}

enum Base44ReferralStatus {
  pending
  completed
  expired
}

enum ReferralCashoutStatus {
  pending
  available
  requested
  paid
}

enum WaitingListStatus {
  pending
  notified
  activated
}

enum CityStatus {
  active
  inactive
}

enum FareProfileDataStatus {
  confirmed
  needs_verification
}

enum AIAvailability {
  available
  unavailable
  unknown
}

enum AIFreeStatus {
  free
  paid
  unknown
}

enum OfflineActionStatus {
  queued
  processed
  failed
  expired
  blocked
}

enum UserType {
  passenger
  driver
  admin
}

enum DisputeRaisedBy {
  passenger
  driver
  admin
}

enum VerificationTier {
  tier_0 // unverified
  tier_1 // NIN only
  tier_2 // NIN + Licence
  tier_3 // all 5 documents approved
}

enum PromoDiscountType {
  percent // discountValue in basis points (1000 = 10%)
  fixed   // discountValue in kobo
}

enum ConversationType {
  trip
  support
}

enum MessageSenderType {
  passenger
  driver
  admin
}

// --- Risk mitigation enums ---

enum ReferralStatus {
  pending
  qualified
  rewarded
}

enum DriverFeatureName {
  loan
  insurance
  fuel_discount
  spare_parts
}

enum PartnerType {
  union
  estate
  fm_company
  church
  corporate
  government
}

enum PartnerStatus {
  prospecting
  engaged
  active
  inactive
}

enum SupportTicketCategory {
  wrong_fare
  driver_rude
  passenger_rude
  lost_item
  driver_late
  wrong_location
  payment_issue
  other
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum FraudEventType {
  gps_spoofing
  fare_manipulation
  fake_trip
  payment_fraud
  account_sharing
  refund_abuse
  device_multiple_accounts
  other
}

enum FraudSeverity {
  low
  medium
  high
  critical
}

enum FraudEventStatus {
  open
  investigating
  resolved
}

enum ActivityStatus {
  dormant
  occasional
  active
  power
}

// --- HCE enums ---

enum LanguageCode {
  en
  ha
  yo
  ig
  pcm
}

enum LandmarkType {
  junction
  building
  market
  estate_gate
  mosque
  hospital
  school
  other
}

enum ComplianceEventType {
  zone_entry
  zone_exit
  restricted_zone_violation
  document_check
  fine_issued
  suspension
  reinstatement
  other
}

enum NotificationType {
  trip
  payment
  kyc
  promo
  system
  broadcast
  sos
  subscription
  fraud_alert
}

enum HceService {
  transcribe
  translate
  speak
  voice_booking
  landmark
  assistant
  intent_extract
}

// ============================================================================
// USERS (passengers)
// ============================================================================

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  phone              String   @unique
  email              String?  @unique
  name               String?
  avatarUrl          String?  @map("avatar_url")
  fcmToken           String?  @map("fcm_token")
  preferredLanguage  String   @default("en") @map("preferred_language") // en | pcm | ha | yo
  higoPoints         Int      @default(0) @map("higo_points")
  ratingAvg          Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  totalTrips         Int      @default(0) @map("total_trips")
  isVerified         Boolean  @default(false) @map("is_verified")
  isBlocked          Boolean  @default(false) @map("is_blocked")
  emergencyContacts  Json?    @map("emergency_contacts") @db.JsonB // [{name, phone, relationship}]
  savedPlaces        Json?    @map("saved_places") @db.JsonB // [{label, address, lat, lng}]

  // Risk mitigation: fraud (Risk 13)
  fraudRiskLevel     String   @default("normal") @map("fraud_risk_level") // normal | elevated | high
  refundRequestCount Int      @default(0) @map("refund_request_count")
  disputeRate        Decimal  @default(0) @map("dispute_rate") @db.Decimal(4, 2)

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // A user MAY also be a driver (drivers.user_id FK)
  driverProfile      Driver?
  tripsAsPassenger   Trip[]          @relation("PassengerTrips")
  notifications      Notification[]  @relation("UserNotifications")
  conversations      Conversation[]  @relation("PassengerConversations")
  supportTickets     SupportTicket[] @relation("SupportTickets")
  fraudEvents        FraudEvent[]    @relation("PassengerFraudEvents")
  fareWatchAlerts    FareWatchAlert[] @relation("FareWatchAlerts")
  languagePreference UserLanguagePreference?
  hceUsageLogs       HceUsageLog[]   @relation("HceUsageLogs")
  fareNegotiations   FareNegotiation[]
  deliveriesSent     Delivery[]      @relation("DeliverySender")
  loyaltyAccount     LoyaltyAccount?
  passengerReferrals Referral[]      @relation("ReferredUser")
  waitingListEntries WaitingList[]
  subscriptionCouponRedemptions SubscriptionCouponRedemption[]

  @@index([phone])
  @@index([email])
  @@index([isBlocked])
  @@index([fraudRiskLevel])
  @@map("users")
}

// ============================================================================
// DRIVERS
// ============================================================================

model Driver {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String?          @unique @map("user_id") @db.Uuid
  name                  String
  phone                 String           @unique
  email                 String?          @unique
  avatarUrl             String?          @map("avatar_url")
  fcmToken              String?          @map("fcm_token")

  vehicleType           VehicleType      @default(keke) @map("vehicle_type")
  vehiclePlate          String           @map("vehicle_plate")
  vehicleModel          String?          @map("vehicle_model")
  vehicleYear           Int?             @map("vehicle_year")
  vehicleColor          String?          @map("vehicle_color")

  kycStatus             KYCStatus        @default(pending) @map("kyc_status")
  kycDocuments          Json?            @map("kyc_documents") @db.JsonB // {nin:{...}, licence:{...}, ...}
  verificationTier      VerificationTier @default(tier_0) @map("verification_tier")

  // NDPA: encrypted at rest (AES-256-GCM) -> stored as {iv,tag,ciphertext}
  ninEncrypted          Json?            @map("nin_encrypted") @db.JsonB
  bankDetailsEncrypted  Json?            @map("bank_details_encrypted") @db.JsonB
  paystackRecipientCode String?          @map("paystack_recipient_code")

  ratingAvg             Decimal          @default(0) @map("rating_avg") @db.Decimal(3, 2)
  totalTrips            Int              @default(0) @map("total_trips")
  isOnline              Boolean          @default(false) @map("is_online")
  isActive              Boolean          @default(true) @map("is_active")
  isSuspended           Boolean          @default(false) @map("is_suspended")

  city                  String?          @map("city")
  state                 String?          @map("state")

  subscriptionTier      SubscriptionTier? @map("subscription_tier")
  subscriptionExpiresAt DateTime?         @map("subscription_expires_at")

  // FCTA compliance: which permitted zones this driver operates in
  operatingZoneIds      String[]          @map("operating_zone_ids") @db.Uuid

  // PostGIS — write/read via raw SQL only. ST_SetSRID(ST_MakePoint(lng,lat),4326)::geography
  currentLocation       Unsupported("geography(Point,4326)")? @map("current_location")

  // Risk mitigation: referral (Risk 1)
  referralCode          String?          @unique @map("referral_code")

  // Risk mitigation: fraud (Risk 13)
  fraudRiskScore        Int              @default(0) @map("fraud_risk_score")
  fraudFlags            Json?            @default("[]") @map("fraud_flags") @db.JsonB

  // Device fingerprinting (Risk 13)
  deviceId              String?          @map("device_id")
  deviceIdLocked        Boolean          @default(false) @map("device_id_locked")

  // Composite Trust Score components (Agent 2 matching engine)
  compositeScore        Decimal?         @map("composite_score") @db.Decimal(4, 2)
  punctualityScore      Decimal?         @map("punctuality_score") @db.Decimal(4, 2)
  complaintRate         Decimal?         @map("complaint_rate") @db.Decimal(4, 2)
  acceptanceRate        Decimal?         @map("acceptance_rate") @db.Decimal(4, 2)
  completionRate        Decimal?         @map("completion_rate") @db.Decimal(4, 2)
  consecutiveRejections Int              @default(0) @map("consecutive_rejections")

  // Financial
  feeOwed               Decimal          @default(0) @map("fee_owed") @db.Decimal(10, 2)

  // Activity tracking (recalculated nightly by DriverActivityJob)
  activityStatus        String           @default("dormant") @map("activity_status") // ActivityStatus enum value
  lastTripAt            DateTime?        @map("last_trip_at")
  tripsLast7Days        Int              @default(0) @map("trips_last_7_days")

  // Subscription loyalty
  subscriptionLoyaltyMonths Int          @default(0) @map("subscription_loyalty_months")

  // Fare negotiation auto-respond settings
  autoAcceptThreshold    Decimal?  @map("auto_accept_threshold") @db.Decimal(10, 2) // auto-accept offers >= this
  autoCounterThreshold   Decimal?  @map("auto_counter_threshold") @db.Decimal(10, 2) // auto-counter when offer < this
  autoCounterAmount      Decimal?  @map("auto_counter_amount") @db.Decimal(10, 2) // amount to counter with
  maxNegotiationDistKm   Decimal?  @map("max_negotiation_dist_km") @db.Decimal(5, 1) // max dist for negotiation offers
  maxPickupTimeMin       Int?      @map("max_pickup_time_min") // max pickup ETA for negotiation offers

  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  user                  User?            @relation(fields: [userId], references: [id])
  tripsAsDriver         Trip[]           @relation("DriverTrips")
  locationHistory       DriverLocation[] @relation("DriverLocationHistory")
  subscriptions         Subscription[]   @relation("DriverSubscriptions")
  conversations         Conversation[]   @relation("DriverConversations")
  referralsGiven        DriverReferral[] @relation("ReferrerDriver")
  referralsReceived     DriverReferral[] @relation("ReferredDriver")
  featureInterests      DriverFeatureInterest[] @relation("DriverFeatureInterests")
  supportTickets        SupportTicket[]  @relation("AssignedSupportTickets")
  fraudEvents           FraudEvent[]     @relation("DriverFraudEvents")
  driverVocabulary      DriverVocabulary[] @relation("DriverVocabulary")
  regulatoryAuditLogs   RegulatoryAuditLog[] @relation("RegulatoryAuditDriver")
  trainingCompletions   DriverTrainingCompletion[]
  selectedFareNegotiations FareNegotiation[]
  deliveriesAsRider   Delivery[]          @relation("DeliveryRider")
  base44ReferralsReceived Referral[]      @relation("ReferralReferredDriver")
  subscriptionCouponRedemptions SubscriptionCouponRedemption[]

  @@index([kycStatus])
  @@index([isSuspended])
  @@index([subscriptionExpiresAt])
  @@index([referralCode])
  @@index([activityStatus])
  @@index([fraudRiskScore])
  @@index([city])
  // GiST index on (is_online, current_location) for nearest-driver search must be
  // added via raw SQL migration:
  //   CREATE INDEX idx_drivers_online_location ON drivers USING GIST (current_location)
  //     WHERE is_online = true;
  @@map("drivers")
}

// ============================================================================
// DELIVERIES
// ============================================================================

model Delivery {
  id                  String         @id @default(uuid()) @db.Uuid
  senderId            String         @map("sender_id") @db.Uuid
  senderName          String?        @map("sender_name")
  senderPhone         String?        @map("sender_phone")
  city                String         @default("Abuja")
  pickupLocation      Unsupported("geography(Point,4326)") @map("pickup_location")
  pickupAddress       String         @map("pickup_address")
  dropoffLocation     Unsupported("geography(Point,4326)") @map("dropoff_location")
  dropoffAddress      String         @map("dropoff_address")
  recipientName       String         @map("recipient_name")
  recipientPhone      String         @map("recipient_phone")
  parcelSize          ParcelSize     @default(small) @map("parcel_size")
  parcelDescription   String?        @map("parcel_description")
  parcelPhotoUrl      String?        @map("parcel_photo_url")
  vehicleType         VehicleType    @default(bike) @map("vehicle_type")
  status              DeliveryStatus @default(requested)
  riderId             String?        @map("rider_id") @db.Uuid
  estimatedFare       Int            @default(0) @map("estimated_fare")
  totalFare           Int            @default(0) @map("total_fare")
  distanceKm          Decimal?       @map("distance_km") @db.Decimal(8, 3)
  durationMin         Int?           @map("duration_min")
  paymentMethod       PaymentMethod  @default(cash) @map("payment_method")
  paymentStatus       PaymentStatus  @default(pending) @map("payment_status")
  deliveryPhotoUrl    String?        @map("delivery_photo_url")
  recipientVerified   Boolean        @default(false) @map("recipient_verified")
  trackingLocation    Unsupported("geography(Point,4326)")? @map("tracking_location")
  acceptedAt          DateTime?      @map("accepted_at")
  pickedUpAt          DateTime?      @map("picked_up_at")
  deliveredAt         DateTime?      @map("delivered_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  cancelReason        String?        @map("cancel_reason")
  description         String?
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  sender              User           @relation("DeliverySender", fields: [senderId], references: [id])
  rider               Driver?        @relation("DeliveryRider", fields: [riderId], references: [id])

  @@index([status])
  @@index([senderId])
  @@index([riderId])
  @@index([createdAt])
  @@index([city])
  @@map("deliveries")
}

model DriverApplication {
  id                 String                  @id @default(uuid()) @db.Uuid
  fullName           String                  @map("full_name")
  phone              String                  @unique
  email              String?
  city               String                  @default("Abuja")
  preferredLanguage  String                  @default("en") @map("preferred_language")
  vehicleType        VehicleType             @default(keke) @map("vehicle_type")
  vehiclePlate       String?                 @map("vehicle_plate")
  vehicleModel       String?                 @map("vehicle_model")
  hasSmartphone      Boolean                 @default(true) @map("has_smartphone")
  hasNin             Boolean                 @default(false) @map("has_nin")
  hasDriversLicence  Boolean                 @default(false) @map("has_drivers_licence")
  status             DriverApplicationStatus @default(new)
  source             String                  @default("web")
  consentAccepted    Boolean                 @default(false) @map("consent_accepted")
  notes              String?
  metadata           Json?                   @db.JsonB
  convertedDriverId  String?                 @map("converted_driver_id") @db.Uuid
  contactedAt        DateTime?               @map("contacted_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@index([city])
  @@index([createdAt])
  @@map("driver_applications")
}

model DriverTrainingCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  moduleKey   String   @map("module_key")
  completedAt DateTime @default(now()) @map("completed_at")
  score       Int?
  metadata    Json?    @db.JsonB

  driver      Driver   @relation(fields: [driverId], references: [id])

  @@unique([driverId, moduleKey])
  @@index([driverId])
  @@map("driver_training_completions")
}

model ContactSubmission {
  id        String                  @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  role      String
  message   String
  source    String                  @default("web")
  status    ContactSubmissionStatus @default(new)
  metadata  Json?                   @db.JsonB
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("contact_submissions")
}

// ============================================================================
// TRIPS
// ============================================================================

model Trip {
  id                   String      @id @default(uuid()) @db.Uuid
  passengerId          String      @map("passenger_id") @db.Uuid
  driverId             String?     @map("driver_id") @db.Uuid

  // PostGIS points — raw SQL only
  pickupLocation       Unsupported("geography(Point,4326)") @map("pickup_location")
  pickupAddress        String      @map("pickup_address")
  destinationLocation  Unsupported("geography(Point,4326)") @map("destination_location")
  destinationAddress   String      @map("destination_address")

  routePolyline        String?     @map("route_polyline") // encoded polyline
  distanceKm           Decimal?    @map("distance_km") @db.Decimal(8, 3)
  durationMin          Int?        @map("duration_min")

  vehicleType          VehicleType @default(keke) @map("vehicle_type")
  status               TripStatus  @default(requested)

  // All fares in KOBO (Int)
  baseFare             Int         @default(0) @map("base_fare")
  distanceFare         Int         @default(0) @map("distance_fare")
  timeFare             Int         @default(0) @map("time_fare")
  surgeMultiplier      Decimal     @default(1.0) @map("surge_multiplier") @db.Decimal(4, 2)
  totalFare            Int         @default(0) @map("total_fare")
  rawFare              Int         @default(0) @map("raw_fare")
  quotedFare           Int         @default(0) @map("quoted_fare")
  minimumFare          Int         @default(0) @map("minimum_fare")
  minimumFareApplied   Boolean     @default(false) @map("minimum_fare_applied")
  modeMultiplier       Decimal     @default(1.0) @map("mode_multiplier") @db.Decimal(5, 2)
  pricingVersion       String      @default("v2.0") @map("pricing_version")
  customerBookingFee   Int         @default(0) @map("customer_booking_fee")
  customerStatutoryLevy Int        @default(0) @map("customer_statutory_levy")

  paymentMethod        PaymentMethod? @map("payment_method")
  paymentStatus        PaymentStatus  @default(pending) @map("payment_status")
  paystackReference    String?        @unique @map("paystack_reference")
  promoCode            String?        @map("promo_code")
  discountAmount       Int            @default(0) @map("discount_amount")

  passengerRating      Int?        @map("passenger_rating") // 1..5 rating GIVEN BY driver to passenger
  driverRating         Int?        @map("driver_rating")    // 1..5 rating GIVEN BY passenger to driver

  rideSharePartnerId   String?     @map("ride_share_partner_id") @db.Uuid
  isShared             Boolean     @default(false) @map("is_shared")
  rideMode             RideMode    @default(instant) @map("ride_mode")
  negotiationId        String?     @map("negotiation_id") @db.Uuid
  scheduledFor         DateTime?   @map("scheduled_for")
  isScheduled          Boolean     @default(false) @map("is_scheduled")

  startedAt            DateTime?   @map("started_at")
  completedAt          DateTime?   @map("completed_at")
  cancelledAt          DateTime?   @map("cancelled_at")
  cancelReason         String?     @map("cancel_reason")

  // Pickup enrichment (Risk 10 — pickup accuracy)
  pickupLandmark       String?     @map("pickup_landmark")
  pickupVoiceNoteUrl   String?     @map("pickup_voice_note_url") @db.VarChar(500)
  pickupConfirmedAt    DateTime?   @map("pickup_confirmed_at")
  pickupAttempts       Int         @default(0) @map("pickup_attempts")

  // Actual pickup (may differ from requested)
  actualPickupLocation Unsupported("geography(Point,4326)")? @map("actual_pickup_location")

  // Cash confirmation (anti-fraud)
  cashConfirmedByDriver Boolean   @default(false) @map("cash_confirmed_by_driver")
  cashConfirmedAt      DateTime?  @map("cash_confirmed_at")

  // Driver rejection tracking
  rejectionReason      String?     @map("rejection_reason") @db.VarChar(100)

  // P0: City derived from pickup location for matching filter
  city                 String?     @map("city")

  createdAt            DateTime    @default(now()) @map("created_at")

  passenger            User        @relation("PassengerTrips", fields: [passengerId], references: [id])
  driver               Driver?     @relation("DriverTrips", fields: [driverId], references: [id])
  negotiation          FareNegotiation? @relation("TripNegotiation", fields: [negotiationId], references: [id])
  disputes             Dispute[]       @relation("TripDisputes")
  conversation         Conversation?   @relation("TripConversation")
  supportTickets       SupportTicket[] @relation("TripSupportTickets")
  fraudEvents          FraudEvent[]    @relation("TripFraudEvents")
  fareWatchAlerts      FareWatchAlert[] @relation("TripFareWatchAlerts")
  landmarkResolutions  LandmarkResolution[] @relation("TripLandmarkResolutions")

  @@index([status])
  @@index([passengerId])
  @@index([driverId])
  @@index([paymentStatus])
  @@index([rideMode])
  @@index([negotiationId])
  @@index([createdAt])
  @@index([city])
  // GiST on pickup_location for geofencing checks (raw SQL migration):
  //   CREATE INDEX idx_trips_pickup_location ON trips USING GIST (pickup_location);
  @@map("trips")
}

model FareNegotiation {
  id                     String                 @id @default(uuid()) @db.Uuid
  passengerId            String                 @map("passenger_id") @db.Uuid
  passengerName          String?                @map("passenger_name")
  selectedDriverId       String?                @map("selected_driver_id") @db.Uuid
  selectedDriverName     String?                @map("selected_driver_name")
  pickupAddress          String                 @map("pickup_address")
  pickupLat              Decimal                @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng              Decimal                @map("pickup_lng") @db.Decimal(10, 7)
  destinationAddress     String                 @map("destination_address")
  destinationLat         Decimal                @map("destination_lat") @db.Decimal(10, 7)
  destinationLng         Decimal                @map("destination_lng") @db.Decimal(10, 7)
  vehicleType            VehicleType            @default(keke) @map("vehicle_type")
  estimatedFare          Int                    @map("estimated_fare")
  passengerOffer         Int                    @map("passenger_offer")
  finalFare              Int?                   @map("final_fare")
  distanceKm             Decimal?               @map("distance_km") @db.Decimal(8, 3)
  durationMin            Int?                   @map("duration_min")
  currentRound           Int                    @default(1) @map("current_round")
  maxRounds              Int                    @default(3) @map("max_rounds")
  status                 FareNegotiationStatus  @default(active)
  driverResponses        Json                   @default("[]") @map("driver_responses") @db.JsonB
  closedReason           String?                @map("closed_reason")
  negotiationDurationSec Int?                   @map("negotiation_duration_sec")
  expiresAt              DateTime               @map("expires_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  passenger              User                   @relation(fields: [passengerId], references: [id])
  selectedDriver         Driver?                @relation(fields: [selectedDriverId], references: [id])
  trips                  Trip[]                 @relation("TripNegotiation")

  @@index([passengerId, status])
  @@index([selectedDriverId])
  @@index([status, expiresAt])
  @@map("fare_negotiations")
}

// ============================================================================
// DRIVER LOCATIONS (append-only history)
// ============================================================================

model DriverLocation {
  id         String   @id @default(uuid()) @db.Uuid
  driverId   String   @map("driver_id") @db.Uuid

  // PostGIS point — raw SQL only
  location   Unsupported("geography(Point,4326)") @map("location")
  bearing    Decimal? @db.Decimal(6, 2)
  speed      Decimal? @db.Decimal(6, 2)
  accuracy   Decimal? @db.Decimal(6, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  driver     Driver   @relation("DriverLocationHistory", fields: [driverId], references: [id])

  @@index([driverId, recordedAt])
  // GiST on location for spatial history queries (raw SQL migration):
  //   CREATE INDEX idx_driver_locations_location ON driver_locations USING GIST (location);
  @@map("driver_locations")
}

// ============================================================================
// ZONES (geofencing + surge)
// ============================================================================

model Zone {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  zoneType        ZoneType @map("zone_type")

  // PostGIS polygon — raw SQL only
  boundary        Unsupported("geography(Polygon,4326)") @map("boundary")

  surgeMultiplier Decimal  @default(1.0) @map("surge_multiplier") @db.Decimal(4, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  surgeRules      SurgeRule[] @relation("ZoneSurgeRules")
  communityPartners CommunityPartner[] @relation("ZoneCommunityPartners")
  fareWatchAlerts FareWatchAlert[] @relation("ZoneFareWatchAlerts")
  regulatoryAuditLogs RegulatoryAuditLog[] @relation("ZoneRegulatoryAudit")

  @@index([zoneType])
  @@index([isActive])
  // GiST on boundary for ST_Contains (raw SQL migration):
  //   CREATE INDEX idx_zones_boundary ON zones USING GIST (boundary);
  // SEED DATA REQUIRED:
  //   Restricted: Maitama, Asokoro, Guzape, Ahmadu Bello Way,
  //               Nnamdi Azikiwe Expressway, Yakubu Gowon Crescent
  //   Permitted (launch): Apo, Galadimawa, Lugbe FHA, Lokogoma, Kuje, Gosa,
  //               Gaduwa, Gwarimpa, Dawaki, Kubwa, Nyanya, Karu
  //   Polygon coordinates pending client sign-off (see ADR Item 4).
  @@map("zones")
}

// ============================================================================
// PRICING CONFIG
// ============================================================================

model PricingConfig {
  id                            String      @id @default(uuid()) @db.Uuid
  vehicleType                   VehicleType @map("vehicle_type")
  city                          String?
  baseFare                      Int         @map("base_fare")    // kobo
  perKmFare                     Int         @map("per_km_fare")  // kobo
  perMinFare                    Int         @map("per_min_fare") // kobo
  minFare                       Int         @map("min_fare")     // kobo
  roundingIncrement             Int         @default(5000) @map("rounding_increment")
  customerBookingFee            Int         @default(0) @map("customer_booking_fee")
  customerStatutoryLevy         Int         @default(0) @map("customer_statutory_levy")
  priceIsAllIn                  Boolean     @default(true) @map("price_is_all_in")
  instantMultiplier             Decimal     @default(1.0) @map("instant_multiplier") @db.Decimal(5, 2)
  negotiateRecommendedMultiplier Decimal    @default(1.0) @map("negotiate_recommended_multiplier") @db.Decimal(5, 2)
  negotiateMinimumOfferMultiplier Decimal   @default(0.9) @map("negotiate_minimum_offer_multiplier") @db.Decimal(5, 2)
  negotiateFastMatchMultiplier  Decimal     @default(1.1) @map("negotiate_fast_match_multiplier") @db.Decimal(5, 2)
  sharePassengerMultiplier      Decimal     @default(0.66) @map("share_passenger_multiplier") @db.Decimal(5, 2)
  shareMinimumMatchedPassengers Int         @default(2) @map("share_minimum_matched_passengers")
  shareRequiresConfirmedMatch   Boolean     @default(true) @map("share_requires_confirmed_match")
  shareMaximumDetourMinutes     Int         @default(8) @map("share_maximum_detour_minutes")
  scheduleFlexibleMultiplier    Decimal     @default(0.9) @map("schedule_flexible_multiplier") @db.Decimal(5, 2)
  scheduleExactTimeMultiplier   Decimal     @default(1.05) @map("schedule_exact_time_multiplier") @db.Decimal(5, 2)
  surgeEnabled                  Boolean     @default(false) @map("surge_enabled")
  surgeMaximumMultiplier        Decimal     @default(1.2) @map("surge_maximum_multiplier") @db.Decimal(4, 2)
  pricingVersion                String      @default("v2.0") @map("pricing_version")
  currency                      String      @default("NGN")
  isActive                      Boolean     @default(true) @map("is_active")
  updatedAt                     DateTime    @updatedAt @map("updated_at")

  @@index([vehicleType, isActive])
  // SEED DATA REQUIRED: one active row per vehicle type (keke at minimum).
  // Fare values pending client sign-off (see ADR Item 5). All values in kobo.
  @@map("pricing_config")
}

// ============================================================================
// SURGE RULES
// ============================================================================

model SurgeRule {
  id         String   @id @default(uuid()) @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") // 0=Sunday .. 6=Saturday (EXTRACT(DOW))
  startTime  String   @map("start_time")  // 'HH:MM:SS' (compared as ::time)
  endTime    String   @map("end_time")    // 'HH:MM:SS'
  multiplier Decimal  @db.Decimal(4, 2)
  isActive   Boolean  @default(true) @map("is_active")

  zone       Zone     @relation("ZoneSurgeRules", fields: [zoneId], references: [id])

  @@index([zoneId, dayOfWeek, isActive])
  // SEED DATA REQUIRED only if surge enabled at launch (see ADR Item 6).
  @@map("surge_rules")
}

// ============================================================================
// SUBSCRIPTIONS (driver subscription billing)
// ============================================================================

model Subscription {
  id                      String           @id @default(uuid()) @db.Uuid
  driverId                String           @map("driver_id") @db.Uuid
  tier                    SubscriptionTier
  amount                  Int              // kobo
  paystackSubscriptionCode String?         @map("paystack_subscription_code")
  startedAt               DateTime         @default(now()) @map("started_at")
  expiresAt               DateTime         @map("expires_at")
  isActive                Boolean          @default(true) @map("is_active")
  autoRenew               Boolean          @default(false) @map("auto_renew")

  driver                  Driver           @relation("DriverSubscriptions", fields: [driverId], references: [id])

  @@index([driverId, isActive])
  @@index([expiresAt])
  // SEED DATA REQUIRED: Paystack Plan codes per tier in env (see ADR Item 2).
  @@map("subscriptions")
}

// ============================================================================
// DISPUTES
// ============================================================================

model Dispute {
  id           String          @id @default(uuid()) @db.Uuid
  tripId       String          @map("trip_id") @db.Uuid
  raisedBy     DisputeRaisedBy @map("raised_by")
  type         String          // e.g. fare_dispute, no_show, safety, payment
  description  String
  evidenceUrls Json?           @map("evidence_urls") @db.JsonB // [s3 keys / presignable]
  status       DisputeStatus   @default(open)
  resolution   String?
  resolvedBy   String?         @map("resolved_by") @db.Uuid // admin_users.id
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  trip         Trip            @relation("TripDisputes", fields: [tripId], references: [id])

  @@index([status])
  @@index([tripId])
  @@map("disputes")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  userType  UserType @map("user_type") // passenger | driver
  title     String
  body      String
  type      String   // NotificationType enum value: trip | payment | kyc | promo | system | broadcast | sos | subscription | fraud_alert
  data      Json?    @db.JsonB
  isRead    Boolean  @default(false) @map("is_read")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userType])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// ADMIN USERS
// ============================================================================

model AdminUser {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            AdminRole @default(moderator)
  isActive        Boolean   @default(true) @map("is_active")
  supervisorEmail String?   @map("supervisor_email")
  lastLogin       DateTime? @map("last_login")
  createdAt       DateTime  @default(now()) @map("created_at")

  configAuditLogs ConfigAuditLog[]

  @@index([email])
  @@index([role])
  // SEED DATA REQUIRED: one super_admin account (credentials provided securely
  // out-of-band; never commit). Password hashed with argon2id/bcrypt.
  @@map("admin_users")
}

// ============================================================================
// FINANCIAL AUDIT LOGS (append-only)
// ============================================================================

model FinancialAudit {
  id           String   @id @default(uuid()) @db.Uuid
  action       String   // e.g. initialize, charge.success, escrow_release, transfer_create, transfer_success, transfer_failed, refund, subscription_create, subscription_renew, subscription_expire
  actorId      String?  @map("actor_id") @db.Uuid // passenger, driver or admin UUID
  actorType    String?  @map("actor_type") // passenger | driver | admin
  reference    String   @unique
  amount       Int?     // amount in kobo (if applicable)
  beforeStatus String?  @map("before_status")
  afterStatus  String?  @map("after_status")
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@map("financial_audit_logs")
}

// ============================================================================
// COMPLIANCE AUDIT LOGS (append-only, NDPA / FCTA)
// ============================================================================

model ComplianceAudit {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  docType   String?  @map("doc_type")
  action    String
  actorId   String?  @map("actor_id") @db.Uuid
  actorType String?  @map("actor_type")
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([driverId])
  @@index([action])
  @@index([createdAt])
  @@map("compliance_audit_logs")
}

// ============================================================================
// PLATFORM SETTINGS (singleton JSON blob)
// ============================================================================

model PlatformSettings {
  id        String   @id @default("default")
  settings  Json     @db.JsonB // { googleMapsOriginRestriction, smsGatewayChannel, fcmServerKey, maintenanceMode }
  updatedAt DateTime @updatedAt @map("updated_at")

  // MIGRATION NOTE: run `pnpm prisma migrate dev --name add_platform_settings`
  // from apps/api. Seeds one row with id='default' and default integration values.
  @@map("platform_settings")
}

// ============================================================================
// CONFIG AUDIT LOG (append-only) — Admin Studio instant-edit trail
// Mirrors the FinancialAudit/ComplianceAudit append-only pattern rather than
// inventing a new audit convention (Track 06 / BASE44_MIGRATION_PLAN.md §5).
// ============================================================================

model ConfigAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   // top-level PlatformSettings.settings key that changed, e.g. "commission", "match", "banners"
  previousValue Json?    @map("previous_value") @db.JsonB
  newValue      Json?    @map("new_value") @db.JsonB
  changedBy     String   @map("changed_by") @db.Uuid
  changedByType String   @default("admin") @map("changed_by_type")
  createdAt     DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [changedBy], references: [id])

  @@index([key])
  @@index([changedBy])
  @@index([createdAt])
  @@map("config_audit_logs")
}

// ============================================================================
// PROMO CODES
// ============================================================================

model PromoCode {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique
  discountType  PromoDiscountType @map("discount_type")
