  origin                     String
  destination                String
  city                       String                @default("Abuja")
  originLat                  Decimal?              @map("origin_lat") @db.Decimal(10, 7)
  originLng                  Decimal?              @map("origin_lng") @db.Decimal(10, 7)
  destinationLat             Decimal?              @map("destination_lat") @db.Decimal(10, 7)
  destinationLng             Decimal?              @map("destination_lng") @db.Decimal(10, 7)
  corridorCluster            String?               @map("corridor_cluster")
  distanceKmEst              Decimal?              @map("distance_km_est") @db.Decimal(8, 3)
  sharedFareLowNgn           Int?                  @map("shared_fare_low_ngn")
  sharedFareHighNgn          Int?                  @map("shared_fare_high_ngn")
  sharedFareMidNgn           Int?                  @map("shared_fare_mid_ngn")
  typicalOccupancy           Int                   @default(4) @map("typical_occupancy")
  driverGrossSharedNgn       Int?                  @map("driver_gross_shared_ngn")
  realizationFactor          Decimal               @default(0.85) @map("realization_factor") @db.Decimal(4, 2)
  suggestedExclusiveFareNgn  Int?                  @map("suggested_exclusive_fare_ngn")
  demandLevel                String?               @map("demand_level")
