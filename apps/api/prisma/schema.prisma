  restrictedRoads    Json     @default("[]") @map("restricted_roads") @db.JsonB
  transferPoints     Json     @default("[]") @map("transfer_points") @db.JsonB
  kekeParks          Json     @default("[]") @map("keke_parks") @db.JsonB
  operatingHours     Json?    @map("operating_hours") @db.JsonB
  nightRestricted    Boolean  @default(false) @map("night_restricted")
  isExpresswayRoute  Boolean  @default(false) @map("is_expressway_route")
  centerLat          Decimal? @map("center_lat") @db.Decimal(10, 7)
  centerLng          Decimal? @map("center_lng") @db.Decimal(10, 7)
  avgFareMin         Int?     @map("avg_fare_min")
  avgFareMax         Int?     @map("avg_fare_max")
  avgTripDurationMin Int?     @map("avg_trip_duration_min")
  priority           Int      @default(0)
  isActive           Boolean  @default(true) @map("is_active")
  description        String?
  createdAt          DateTime @default(now()) @map("created_at")
